PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/nook
TMDB_API_KEY=replace-with-your-tmdb-api-key
TMDB_TIMEOUT_MS=12000
TMDB_CACHE_TTL_MS=300000
TMDB_SYNC_CONCURRENCY=3
# Required in production: generate at least 32 random characters.
SESSION_SECRET=
# Production defaults to closed registration. Set true temporarily to create another account.
ALLOW_REGISTRATION=false
# Optional MongoDB pool cap for Serverless instances (defaults to 5, maximum 20).
MONGO_MAX_POOL_SIZE=5
# Optional when the local network cannot reach TMDB directly.
# HTTP_PROXY=http://127.0.0.1:10808
# HTTPS_PROXY=http://127.0.0.1:10808
# Optional: comma-separated trusted same-site frontend origins.
# CORS_ORIGIN=http://localhost:5173
