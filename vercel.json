{
  "version": 2,
  "builds": [
    {
      "src": "nook-server/api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "nook-web/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/nook-server/api/index.js" },
    
    { "src": "/(.*)", "dest": "/nook-web/$1", "continue": true },
    
    { "handle": "filesystem" },
    
    { "src": "/(.*)", "dest": "/nook-web/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
